RewriteEngine On

# Redirect /dude to movie-detail.html?id=dude
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)$ movie-detail.html?id=$1 [L,QSA]

# Remove .html extension from other pages (optional but nice)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]